# Hermes Chat — Keystore credentials
# ======================================
# Source this file before building release APKs locally:
#   source app/keystore/keystore.env
#   ./gradlew assembleRelease --no-daemon
#
# For CI, set these as GitHub repository secrets:
#   HERMES_KEYSTORE_BASE64 — base64 of app/keystore/hermes-chat.jks
#     cat app/keystore/hermes-chat.jks | base64 -w0
#   HERMES_STORE_PASSWORD
#   HERMES_KEY_ALIAS
#   HERMES_KEY_PASSWORD
#
# To regenerate the keystore:
#   keytool -genkey -v -keystore app/keystore/hermes-chat.jks \
#     -alias hermes-chat \
#     -keyalg RSA -keysize 2048 -validity 10000

HERMES_STORE_PASSWORD=your-store-password-here
HERMES_KEY_ALIAS=hermes-chat
HERMES_KEY_PASSWORD=your-key-password-here
