<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for local/Tailscale traffic -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">100.80.204.66</domain>
        <domain includeSubdomains="true">192.168.68.105</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">bigred.tail776582.ts.net</domain>
    </domain-config>
    <!-- Default: HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
