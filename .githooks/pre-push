#!/bin/bash
# Pre-push hook: run web export tests, then wait for user approval before pushing.

set -e

PUSH_DATA=$(cat)

echo ""
echo "🔍 Running pre-push checks..."
echo ""

# Step 1: TypeScript type check
echo "📝 TypeScript check..."
npx tsc --noEmit
echo "✅ TypeScript clean"
echo ""

# Step 2: Web export (compiles the full app)
echo "🌐 Web export build..."
npx expo export --platform web 2>&1 | tail -5
echo "✅ Web export OK"
echo ""

echo "============================================"
echo "   ✅ ALL CHECKS PASSED"
echo "============================================"
echo ""

# Check if we're in an interactive terminal
if [ -t 0 ] && [ -c /dev/tty ] 2>/dev/null; then
  echo -n "Push to remote? (y/N): "
  read -r APPROVAL < /dev/tty

  if [ "$APPROVAL" != "y" ] && [ "$APPROVAL" != "Y" ]; then
    echo ""
    echo "⏸️  Push cancelled — nothing was pushed."
    echo "   Run:  git push  — to try again when ready."
    exit 1
  fi

  echo ""
  echo "🚀 Pushing..."
  # Re-pipe the push data — git already read it from stdin, so we push normally
  git push --no-verify origin "$@"
else
  echo "📋 Non-interactive shell detected."
  echo "   To push, run in your terminal:  git push --no-verify"
  echo ""
  echo "⏸️  Push blocked — user approval required."
  exit 1
fi
